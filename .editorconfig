# obs-multireplay — editor hints only, no build or CI behavior depends on this.
# Tabs, UTF-8, LF: what the tree already is (checked with `cat -A` against
# multireplay-dock.cpp before writing this), not a style being imposed.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h,cpp,hpp,m,mm}]
indent_style = tab
indent_size = 8

[*.{cmake,txt}]
indent_style = space
indent_size = 2

[*.{ps1,psm1}]
indent_style = space
indent_size = 4

[*.{ini,json,yaml,yml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
